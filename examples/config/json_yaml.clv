(ns examples::config::json_yaml)

(def config-json
  #json{
    "host": "localhost",
    "port": 8080
  })

(def config-yaml
  #yaml{
    host: localhost
    port: 8080
  })

;; #json / #yaml keep keys as strings, so index with "host" (not :host).
(defn -main []
  (println "json host =" config-json["host"])
  (println "yaml host =" config-yaml["host"]))
