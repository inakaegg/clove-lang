<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- clove dlopen()s native plugin dylibs the user built themselves, both from
       the default trusted directories and with --allow-native-plugins. Those
       dylibs carry no Developer ID signature, and the hardened runtime would
       reject them in a signed build only. See
       docs/design-notes/prebuilt-binaries.md. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
